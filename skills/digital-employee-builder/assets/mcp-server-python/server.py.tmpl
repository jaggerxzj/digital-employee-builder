"""{{employee_name}} local task tools.

The MCP server is a transport adapter. Business behavior lives in the packaged
employee_runtime and is shared with workflow scripts.

Run: python server.py
Deps: install ../runtime, then install "mcp[cli]"
"""

from typing import Any

from employee_runtime.application import EmployeeApplication
from employee_runtime.ports import DependencyError, DomainError
from mcp.server.fastmcp import FastMCP


mcp = FastMCP("{{employee_name}}-tools")
app = EmployeeApplication.from_environment()


def result_or_error(call) -> dict[str, Any]:
    try:
        return {"ok": True, "data": call()}
    except DomainError as error:
        return {
            "ok": False,
            "error": {
                "kind": "domain_rejection",
                "code": error.code,
                "message": error.message,
                "details": error.details,
            },
        }
    except DependencyError as error:
        return {
            "ok": False,
            "error": {
                "kind": "dependency_failure",
                "code": error.code,
                "message": error.message,
                "adapter": error.adapter,
                "retryable": error.retryable,
                "correlation_id": error.correlation_id,
            },
        }


@mcp.tool()
def {{query_task}}(object_id: str) -> dict[str, Any]:
    """{{user-task query description}} (read-only).

    object_id: {{business identifier meaning and constraints}}
    """
    return result_or_error(lambda: app.{{query_task}}(object_id))


@mcp.tool()
def {{write_task}}(
    {{command_fields}},
    idempotency_key: str,
    dry_run: bool = True,
) -> dict[str, Any]:
    """[WRITE — explicit user confirmation before dry_run=false] {{bounded user action}}.

    dry_run: true validates and reports the planned effect without committing it.
    idempotency_key: stable caller-generated key for safe retry and audit.
    """
    command = {{build command from typed fields}}
    return result_or_error(
        lambda: app.{{write_task}}(
            command,
            dry_run=dry_run,
            idempotency_key=idempotency_key,
        )
    )


if __name__ == "__main__":
    mcp.run()
