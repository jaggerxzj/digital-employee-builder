"""
{{employee_name}}-tools — MCP Server (Python / FastMCP)

Thin-wrapper layer generated by digital-employee-builder:
each tool maps to one capability point in docs/business-capabilities.md.
Only validates params + calls existing business interfaces; no business logic copied.

Run: python3 server.py (stdio mode, spawned by the harness)
Deps: pip install "mcp[cli]" httpx
"""

import os

import httpx
from mcp.server.fastmcp import FastMCP

API_BASE = os.environ.get("BUSINESS_API_BASE", "http://localhost:8080")
API_TOKEN = os.environ.get("BUSINESS_API_TOKEN", "")

mcp = FastMCP("{{employee_name}}-tools")


def _client() -> httpx.Client:
    return httpx.Client(
        base_url=API_BASE,
        headers={"Authorization": f"Bearer {API_TOKEN}"},
        timeout=15,
    )


def _call(method: str, path: str, **kwargs) -> str:
    """Call the business API with normalized error handling."""
    try:
        with _client() as c:
            r = c.request(method, path, **kwargs)
            r.raise_for_status()
            return r.text
    except httpx.HTTPStatusError as e:
        return f"BUSINESS_ERROR_{e.response.status_code}: {e.response.text[:300]}"
    except httpx.RequestError as e:
        return f"CONNECTION_ERROR: {e}"


# ===== Read-only tools (open directly) =====
# Example: generate one per capability point from the inventory

@mcp.tool()
def query_{{business_object}}({{id_param}}: str) -> str:
    """Query {{business_object}} details (read-only).

    {{id_param}}: {{meaning and format, e.g. "order number, 14 chars starting with SO"}}
    Returns: {{response description}}
    """
    return _call("GET", f"/api/{{resource}}/{ {{id_param}} }")


@mcp.tool()
def list_{{business_object}}(status: str = "", limit: int = 20) -> str:
    """List {{business_object}} records (read-only).

    status: {{valid values, e.g. "pending/paid/closed"; empty = all}}
    limit: max records returned, default 20, capped at 100
    """
    return _call("GET", "/api/{{resource}}", params={"status": status, "limit": min(limit, 100)})


# ===== Write tools (confirm-before-execute note in first line) =====

@mcp.tool()
def create_{{business_object}}({{field}}: str) -> str:
    """[WRITE — confirm with the user before executing] Create a {{business_object}}.

    {{field}}: {{meaning and constraints}}
    """
    return _call("POST", "/api/{{resource}}", json={"{{field}}": {{field}}})


if __name__ == "__main__":
    mcp.run()  # stdio
