#!/usr/bin/env python3
"""CLI entrypoint for {{workflow-name}}.

Business behavior lives in employee_runtime. This script only parses input,
calls one application service, and serializes the result.
"""

import argparse
import json
import sys

from employee_runtime.application import EmployeeApplication
from employee_runtime.ports import DomainError


def emit(payload: dict, exit_code: int = 0) -> None:
    print(json.dumps(payload, ensure_ascii=False, indent=2))
    raise SystemExit(exit_code)


def main() -> None:
    parser = argparse.ArgumentParser(description="{{workflow title}}")
    parser.add_argument("--{{id_param}}", required=True, help="{{meaning and format}}")
    parser.add_argument("--idempotency-key", required=True, help="stable key for safe retry")
    parser.add_argument("--dry-run", action="store_true", help="validate without committing effects")
    args = parser.parse_args()

    app = EmployeeApplication.from_environment()
    command = {{build command from arguments}}
    try:
        data = app.{{workflow_method}}(
            command,
            dry_run=args.dry_run,
            idempotency_key=args.idempotency_key,
        )
    except DomainError as error:
        emit(
            {"ok": False, "error": {"code": error.code, "message": error.message}},
            3,
        )
    emit({"ok": True, "data": data})


if __name__ == "__main__":
    main()
