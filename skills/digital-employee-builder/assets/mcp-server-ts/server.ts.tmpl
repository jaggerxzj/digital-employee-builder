/** {{employee_name}} local task tools.
 * Business behavior lives in the packaged runtime; this file is a transport adapter.
 */

import { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
import { z } from "zod";
import { createEmployeeApplication, DependencyError, DomainError } from "../runtime/dist/index.js";

const server = new McpServer({ name: "{{employee_name}}-tools", version: "0.1.0" });
const app = createEmployeeApplication(process.env);

server.tool(
  "{{query_task}}",
  "{{user-task query description}} (read-only)",
  { objectId: z.string().describe("{{business identifier meaning and constraints}}") },
  async ({ objectId }) => {
    try {
      const data = await app.{{query_task}}(objectId);
      return { content: [{ type: "text", text: JSON.stringify({ ok: true, data }) }] };
    } catch (error) {
      if (error instanceof DomainError || error instanceof DependencyError) {
        return { content: [{ type: "text", text: JSON.stringify({ ok: false, error: error.toJSON() }) }], isError: true };
      }
      throw error;
    }
  },
);

server.tool(
  "{{write_task}}",
  "[WRITE — explicit user confirmation before dryRun=false] {{bounded user action}}",
  {
    {{write_schema_fields}}
    idempotencyKey: z.string().min(1).describe("Stable key for safe retry and audit"),
    dryRun: z.boolean().default(true).describe("Validate and report effects without committing"),
  },
  async ({ {{write_field_names}}, idempotencyKey, dryRun }) => {
    try {
      const data = await app.{{write_task}}(
        { {{write_command_fields}} },
        { idempotencyKey, dryRun },
      );
      return { content: [{ type: "text", text: JSON.stringify({ ok: true, data }) }] };
    } catch (error) {
      if (error instanceof DomainError || error instanceof DependencyError) {
        return { content: [{ type: "text", text: JSON.stringify({ ok: false, error: error.toJSON() }) }], isError: true };
      }
      throw error;
    }
  },
);

const transport = new StdioServerTransport();
await server.connect(transport);
