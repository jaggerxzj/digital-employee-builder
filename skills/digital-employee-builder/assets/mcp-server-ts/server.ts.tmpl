/**
 * {{employee_name}}-tools — MCP Server (TypeScript)
 *
 * Thin-wrapper layer generated by digital-employee-builder.
 * Use this template when the business system is in the Node/TS ecosystem
 * so business modules can be imported directly.
 *
 * Deps: npm i @modelcontextprotocol/sdk
 * Run: npx tsx server.ts (stdio mode)
 */

import { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
import { z } from "zod";

const API_BASE = process.env.BUSINESS_API_BASE ?? "http://localhost:8080";
const API_TOKEN = process.env.BUSINESS_API_TOKEN ?? "";

const server = new McpServer({ name: "{{employee_name}}-tools", version: "1.0.0" });

async function callApi(path: string, init?: RequestInit): Promise<string> {
  try {
    const res = await fetch(`${API_BASE}${path}`, {
      ...init,
      headers: { Authorization: `Bearer ${API_TOKEN}`, "Content-Type": "application/json" },
      signal: AbortSignal.timeout(15000),
    });
    const text = await res.text();
    return res.ok ? text : `BUSINESS_ERROR_${res.status}: ${text.slice(0, 300)}`;
  } catch (e) {
    return `CONNECTION_ERROR: ${e}`;
  }
}

// ===== Read-only tools =====

server.tool(
  "query_{{business_object}}",
  "Query {{business_object}} details (read-only)",
  { {{id_param}}: z.string().describe("{{meaning and format}}") },
  async ({ {{id_param}} }) => ({
    content: [{ type: "text", text: await callApi(`/api/{{resource}}/${{id_param}}`) }],
  })
);

// ===== Write tools (confirm-before-execute note in description) =====

server.tool(
  "create_{{business_object}}",
  "[WRITE — confirm with the user before executing] Create a {{business_object}}",
  { {{field}}: z.string().describe("{{meaning and constraints}}") },
  async (input) => ({
    content: [
      { type: "text", text: await callApi("/api/{{resource}}", { method: "POST", body: JSON.stringify(input) }) },
    ],
  })
);

await server.connect(new StdioServerTransport());
